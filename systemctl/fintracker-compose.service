[Unit]
Description=FinTracker compose stack (docker-compose.yml + optional docker-compose.nginx.yml, on `main`)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
__USER_LINE__
WorkingDirectory=__DEPLOY_PATH__
# ./fintrack (published alongside the compose files) does the engine detection and
# automatically layers in docker-compose.nginx.yml when FT_NGINX_ENABLED=true in
# .env -- see deploy/fintrack. Keeps this unit in sync with CI's own deploy scripts
# instead of duplicating that logic here.
ExecStart=__DEPLOY_PATH__/fintrack up
ExecStop=__DEPLOY_PATH__/fintrack down
TimeoutStartSec=300
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=__WANTED_BY__
