# HTTPS template -- used when FT_NGINX_HTTPS=true (the default). Plain-HTTP twin:
# default.conf.https-false.
#
# Rendered by the official nginx image's own docker-entrypoint at container start:
# docker-compose.nginx.yml sets NGINX_ENVSUBST_TEMPLATE_SUFFIX=.https-${FT_NGINX_HTTPS},
# so only the matching file under /etc/nginx/templates/ is passed through `envsubst`
# (using only env vars actually set on the container -- never nginx's own $request_uri
# style variables, which aren't environment variables) and written to
# /etc/nginx/conf.d/default.conf. Variables passed in: FT_DOMAIN,
# FT_FINTRACKER_SUBDOMAIN, FT_MONGO_EXPRESS_SUBDOMAIN.

server {
    listen 80;
    server_name ${FT_FINTRACKER_SUBDOMAIN}.${FT_DOMAIN} ${FT_MONGO_EXPRESS_SUBDOMAIN}.${FT_DOMAIN};
    # Container healthcheck (docker-compose.nginx.yml): answered here, never redirected to
    # https://127.0.0.1, which fails because the certificate is for the real hostnames.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${FT_FINTRACKER_SUBDOMAIN}.${FT_DOMAIN};

    # The issued certificate + its private key -- NOT the CSR, which is only needed
    # once to request the certificate from your CA. Place both files in
    # FT_NGINX_CERTS_DIR on the host before starting this.
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    client_max_body_size 25m;

    location / {
        proxy_pass http://fintracker:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${FT_MONGO_EXPRESS_SUBDOMAIN}.${FT_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    location / {
        proxy_pass http://mongo-express:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
